flowchart TD
    REQ([Request]) --> AUTH[Auth — api_key]
    AUTH --> RULE[Lookup rule]
    RULE --> RL[Rate check]
    RL --> DEC{allowed?}
    DEC -->|Yes| ROUTE[Backend] --> OK([200 + headers])
    DEC -->|No| BLOCK([429])
    DEC -->|Redis down| ROUTE

    style OK fill:#d4edda,stroke:#28a745,color:#1a1a1a
    style BLOCK fill:#f8d7da,stroke:#dc3545,color:#1a1a1a
