flowchart TD
    START([Request]) --> LOAD[Load bucket from Redis]
    LOAD --> REFILL[Refill tokens]
    REFILL --> CHECK{tokens >= 1?}
    CHECK -->|Yes| DEC[Decrement + save] --> ALLOW([Allow])
    CHECK -->|No| DENY([Deny → 429])

    style ALLOW fill:#d4edda,stroke:#28a745,color:#1a1a1a
    style DENY fill:#f8d7da,stroke:#dc3545,color:#1a1a1a
